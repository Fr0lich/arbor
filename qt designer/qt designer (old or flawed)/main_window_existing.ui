<?xml version='1.0' encoding='UTF-8'?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1440</width>
    <height>900</height>
   </rect>
  </property>
  <property name="minimumSize">
   <size>
    <width>1000</width>
    <height>640</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>arbor — Review Workspace</string>
  </property>
  <property name="styleSheet">
   <string notr="true">/* =========================================
   Arbor Main Review Workspace Theme &amp; Tokens
   (mirrors qt designer/arbor.ui conventions)
   ========================================= */

QMainWindow#MainWindow, QWidget#centralwidget {
    background-color: #fbfaf8;
    color: #2c302e;
    font-family: 'Segoe UI', 'Inter', sans-serif;
    font-size: 12px;
}

QLabel { background: transparent; color: #2c302e; }
QToolTip { background-color: #2c302e; color: #ffffff; border: none; padding: 4px 6px; }

/* ---------- LAYER 1: Navigation bar ---------- */
QFrame#nav_bar {
    background-color: #e9ece5;
    border: 1px solid #8b948d;
}
QLabel#lbl_title {
    color: #000000;
    font-family: 'Segoe UI', sans-serif;
    font-size: 16px;
    font-weight: bold;
    padding: 0px 16px;
}
QFrame#nav_sep_1, QFrame#nav_sep_2, QFrame#nav_sep_3, QFrame#nav_sep_4 {
    background-color: #8b948d; border: none; max-width: 1px; min-width: 1px;
}
QPushButton#btn_nav_file, QPushButton#btn_nav_data, QPushButton#btn_nav_images,
QPushButton#btn_nav_create, QPushButton#btn_nav_recent, QPushButton#btn_nav_gbif,
QPushButton#btn_nav_mobile, QPushButton#btn_prev, QPushButton#btn_next,
QPushButton#btn_last, QPushButton#btn_filter, QPushButton#btn_peek,
QPushButton#btn_sync_mobile {
    background-color: transparent;
    color: #2c302e;
    border: none;
    border-radius: 0px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#btn_nav_file:hover, QPushButton#btn_nav_data:hover, QPushButton#btn_nav_images:hover,
QPushButton#btn_nav_create:hover, QPushButton#btn_nav_recent:hover, QPushButton#btn_nav_presets:hover,
QPushButton#btn_nav_gbif:hover, QPushButton#btn_nav_mobile:hover, QPushButton#btn_prev:hover,
QPushButton#btn_next:hover, QPushButton#btn_last:hover, QPushButton#btn_filter:hover,
QPushButton#btn_peek:hover, QPushButton#btn_sync_mobile:hover {
    background-color: #ffffff;
}
QPushButton#btn_sync_mobile:disabled { color: #747878; }
QPushButton#btn_filter, QPushButton#btn_peek, QPushButton#btn_sync_mobile {
    background-color: #fbfaf8; border: 1px solid #c4c7c7; padding: 4px 8px; font-size: 11px;
}
QPushButton#btn_next_problem, QPushButton#btn_next_hist {
    background-color: #000000;
    color: #ffffff;
    border: none;
    border-radius: 0px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: bold;
}
QPushButton#btn_next_problem:hover, QPushButton#btn_next_hist:hover { background-color: #2c302e; }
QPushButton#btn_next_hist:disabled { background-color: #dadada; color: #747878; }
QLabel#lbl_system_status { color: #444748; }
QLabel#lbl_data_status { font-weight: bold; color: #3a7d44; }
QLabel#lbl_data_status[unsaved="true"] { color: #d9a036; }
QLabel#lbl_online_dot { color: #3a7d44; font-size: 11px; }
QLabel#lbl_online {
    color: #444748; font-family: 'Courier New', 'JetBrains Mono', monospace; font-size: 11px;
}

/* ---------- LAYER 2: Inline banner (hidden by default) ---------- */
QFrame#banner_frame { background-color: #fcf5e3; border: 1px solid #d9a036; }
QLabel#lbl_banner_text { color: #5e4311; font-weight: 600; }
QPushButton#btn_banner_action, QPushButton#btn_banner_close {
    background: transparent; border: none; color: #5e4311; font-weight: bold; padding: 2px 8px;
}

/* ---------- Splitter ---------- */
QSplitter::handle { background-color: #c4c7c7; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }

/* ---------- LEFT PANE ---------- */
QFrame#action_rail { background-color: #e9ece5; border: 1px solid #c4c7c7; }
QPushButton#btn_rail_pin, QPushButton#btn_rail_drawer {
    background: transparent; border: none; border-radius: 0px; padding: 4px; font-size: 15px;
}
QPushButton#btn_rail_pin:hover, QPushButton#btn_rail_drawer:hover { background-color: #ffffff; }
QLabel#lbl_filter_indicator { color: #c93a40; font-size: 14px; font-weight: bold; }

QWidget#left_content, QWidget#list_container, QWidget#left_bottom_container {
    background-color: #fbfaf8;
}
QLabel#lbl_filter_status { color: #c0392b; font-size: 11px; font-weight: bold; }

QComboBox#combo_sort {
    background-color: #f2f5f1; color: #2c302e; border: 1px solid #747878;
    border-radius: 0px; padding: 3px 8px; font-size: 12px;
}
QComboBox#combo_sort:hover { background-color: #e9ece5; }
QComboBox#combo_sort::drop-down { border: none; width: 18px; }

QFrame#search_frame { background-color: #ffffff; border: 1px solid #d1d1d1; }
QLineEdit#edit_search {
    background-color: #ffffff; color: #2c302e; border: none; padding: 5px 4px; font-size: 13px;
}
QLabel#lbl_search_count {
    color: #747878; font-family: 'Courier New', 'JetBrains Mono', monospace; font-size: 11px;
}
QPushButton#btn_clear_search {
    background: transparent; border: none; color: #747878; font-weight: bold; padding: 2px 6px;
}
QPushButton#btn_clear_search:hover { color: #c93a40; }

QTreeWidget#tree_objects {
    background-color: #ffffff; alternate-background-color: #ffffff;
    border: 1px solid #c4c7c7; outline: 0;
    font-family: 'Courier New', 'JetBrains Mono', monospace; font-size: 12px; color: #2c302e;
}
QTreeWidget#tree_objects::item { padding: 3px 4px; border-bottom: 1px solid #f2f5f1; }
QTreeWidget#tree_objects::item:hover { background-color: #f2f5f1; }
QTreeWidget#tree_objects::item:selected { background-color: #e9ece5; color: #000000; }
QTreeWidget#tree_objects QHeaderView::section {
    background-color: #f2f5f1; color: #2c302e; border: none;
    border-bottom: 1px solid #747878; border-right: 1px solid #c4c7c7;
    padding: 4px 6px; font-family: 'Segoe UI', sans-serif; font-size: 11px; font-weight: bold;
}
QPushButton#btn_bulk_edit {
    background-color: #fbfaf8; color: #2c302e; border: 1px solid #747878;
    border-radius: 0px; padding: 5px 12px; font-size: 12px; font-weight: 600;
}
QPushButton#btn_bulk_edit:hover { background-color: #e9ece5; }
QPushButton#btn_bulk_edit:disabled { color: #747878; border-color: #c4c7c7; }

QFrame#location_container { background-color: #fbfaf8; border-top: 1px solid #c4c7c7; }

/* ---------- CENTER PANE ---------- */
QWidget#pane_center { background-color: #fbfaf8; }
QFrame#context_bar { background-color: #ffffff; border: 1px solid #d1d1d1; }
QLabel#lbl_id_badge {
    background-color: #e9ece5; color: #2c302e; border: 1px solid #c4c7c7;
    padding: 2px 8px; font-family: 'Courier New', 'JetBrains Mono', monospace;
    font-size: 13px; font-weight: bold;
}
QLabel#lbl_specimen_name {
    color: #2c302e; font-family: 'Georgia', 'Lora', serif; font-size: 17px;
    font-weight: bold; font-style: italic;
}
QLabel#lbl_status_badge {
    background-color: #fef3c7; color: #92400e; padding: 2px 6px;
    font-family: 'Courier New', 'JetBrains Mono', monospace; font-size: 11px; font-weight: bold;
}
QLabel#lbl_status_badge[state="reviewed"] { background-color: #eef8f0; color: #214a27; }
QLabel#lbl_status_badge[state="problem"] { background-color: #f9e6e7; color: #6e1d21; }
QPushButton#btn_gbif, QPushButton#btn_check_books {
    background-color: #f2f5f1; color: #2c302e; border: 1px solid #747878;
    border-radius: 0px; padding: 3px 8px; font-size: 12px; font-weight: bold;
}
QPushButton#btn_gbif:hover, QPushButton#btn_check_books:hover { background-color: #e9ece5; }
QPushButton#btn_push_phone {
    background-color: #ffffff; color: #757d77; border: 1px solid #747878;
    border-radius: 0px; padding: 3px 8px; font-size: 12px;
}
QPushButton#btn_push_phone:hover { background-color: #f2f5f1; color: #2c302e; }

QFrame#image_panel { background-color: #ffffff; border: 1px solid #c4c7c7; }
QFrame#image_header { background-color: #f2f5f1; border-bottom: 1px solid #c4c7c7; }
QLabel#lbl_images_title {
    color: #2c302e; font-family: 'Courier New', 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: bold; letter-spacing: 1px;
}
QLabel#lbl_online_images, QLabel#lbl_images_count, QLabel#lbl_images_missing {
    color: #747878; font-size: 11px;
}
QPushButton#btn_view_mode {
    background-color: #fbfaf8; color: #2c302e; border: 1px solid #747878;
    border-radius: 0px; padding: 2px 8px; font-size: 11px;
}
QPushButton#btn_view_mode:hover { background-color: #e9ece5; }
QFrame#image_toolbar { background-color: #fbfaf8; border-bottom: 1px solid #c4c7c7; }
QPushButton#btn_zoom_in, QPushButton#btn_zoom_out, QPushButton#btn_rotate_ccw,
QPushButton#btn_rotate_cw, QPushButton#btn_reset_view, QPushButton#btn_fit_view {
    background-color: #ffffff; color: #2c302e; border: 1px solid #747878;
    border-radius: 0px; padding: 3px 10px; font-size: 12px; font-weight: 600;
}
QPushButton#btn_zoom_in:hover, QPushButton#btn_zoom_out:hover, QPushButton#btn_rotate_ccw:hover,
QPushButton#btn_rotate_cw:hover, QPushButton#btn_reset_view:hover, QPushButton#btn_fit_view:hover {
    background-color: #e9ece5;
}
QPushButton#btn_zoom_in:pressed, QPushButton#btn_zoom_out:pressed, QPushButton#btn_rotate_ccw:pressed,
QPushButton#btn_rotate_cw:pressed, QPushButton#btn_reset_view:pressed, QPushButton#btn_fit_view:pressed {
    background-color: #dadada;
}
QLabel#lbl_zoom_status {
    color: #747878; font-family: 'Courier New', 'JetBrains Mono', monospace; font-size: 11px;
}
QGraphicsView#image_view { background-color: #f2f5f1; border: none; }

/* ---------- RIGHT PANE ---------- */
QWidget#pane_right { background-color: #fbfaf8; }
QFrame#right_header { background-color: #fbfaf8; border-bottom: 1px solid #c4c7c7; }
QLabel#lbl_reg_title { font-size: 16px; font-weight: bold; color: #2c302e; }
QPushButton#btn_history {
    background-color: #ffffff; color: #2c302e; border: 1px solid #747878;
    border-radius: 0px; padding: 2px 8px; font-size: 12px;
}
QPushButton#btn_history:hover { background-color: #e9ece5; }
QLabel#lbl_history_indicator { color: #444748; font-size: 12px; }
QLabel#lbl_focus_mode { font-size: 12px; }
QCheckBox#chk_focus_mode::indicator {
    width: 28px; height: 14px; border: 1px solid #747878; border-radius: 7px; background-color: #ffffff;
}
QCheckBox#chk_focus_mode::indicator:checked { background-color: #3a7d44; border-color: #3a7d44; }

QTabWidget#tabs_registration::pane { border: none; border-top: 1px solid #c4c7c7; background-color: #fbfaf8; }
QTabWidget#tabs_registration QTabBar::tab {
    background-color: #e9ece5; color: #444748; border: 1px solid #c4c7c7; border-bottom: none;
    padding: 6px 16px; font-size: 12px; font-weight: 600;
}
QTabWidget#tabs_registration QTabBar::tab:selected {
    background-color: #ffffff; color: #000000; border-top: 2px solid #000000;
}
QTabWidget#tabs_registration QTabBar::tab:hover:!selected { background-color: #f2f5f1; }

QScrollArea#scroll_general, QScrollArea#scroll_problems { border: none; background-color: #fbfaf8; }
QWidget#scroll_general_contents, QWidget#scroll_problems_contents { background-color: #fbfaf8; }

/* Dynamic registration cards (built at runtime from reg_groups) */
QGroupBox, QFrame[role="card"] {
    background-color: #ffffff; border: 1px solid #c4c7c7; border-radius: 2px;
    margin-top: 10px; padding-top: 8px; font-weight: bold;
}
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; color: #2c302e; background-color: #fbfaf8; }

/* Dynamic form inputs */
QLineEdit, QPlainTextEdit, QComboBox {
    background-color: #f2f5f1; color: #2c302e; border: 1px solid #747878;
    border-radius: 0px; padding: 4px 6px;
    font-family: 'Courier New', 'JetBrains Mono', monospace; font-size: 13px;
}
QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus { background-color: #ffffff; border: 1px solid #000000; }
QLineEdit:read-only, QPlainTextEdit:read-only { background-color: #e9ece5; color: #747878; }
/* Problem-flag highlight: soft yellow tint + solid left bar (Genus_Problem etc.) */
QLineEdit[problem="true"], QPlainTextEdit[problem="true"], QComboBox[problem="true"] {
    background-color: #fef9e7; border: 1px solid #d9a036; border-left: 3px solid #d9a036;
}
QLabel[problem="true"] { color: #c93a40; font-weight: bold; }

QCheckBox { spacing: 6px; color: #2c302e; font-size: 12px; }
QCheckBox::indicator { width: 14px; height: 14px; border: 1px solid #747878; background-color: #ffffff; }
QCheckBox::indicator:checked { background-color: #000000; border-color: #000000; }

/* Fixed bottom action bar */
QFrame#action_bar { background-color: #fbfaf8; border-top: 1px solid #c4c7c7; }
QPushButton#btn_mark_reviewed {
    background-color: #3a7d44; color: #ffffff; border: none; border-radius: 0px;
    padding: 9px 12px; font-size: 13px; font-weight: bold;
}
QPushButton#btn_mark_reviewed:hover { background-color: #2f6638; }
QPushButton#btn_mark_reviewed:pressed { background-color: #13521a; }
QPushButton#btn_mark_reviewed[reviewed="true"] { background-color: #adf0a6; color: #13521a; }
QPushButton#btn_mark_reviewed:disabled { background-color: #dadada; color: #747878; }
QLabel#lbl_data_status_action, QLabel#lbl_reviewed_time {
    color: #757d77; font-family: 'Courier New', 'JetBrains Mono', monospace; font-size: 11px;
}

/* ---------- LAYER 4: Global status bar ---------- */
QFrame#status_bar_frame { background-color: #1c1b1b; }
QFrame#status_top, QFrame#status_bottom { background-color: #1c1b1b; border: none; }
QPushButton#btn_sb_settings, QPushButton#btn_sb_help {
    background-color: transparent; color: #e2e2e2; border: 1px solid #555555;
    border-radius: 0px; padding: 3px 14px; font-size: 11px; font-weight: bold;
}
QPushButton#btn_sb_settings:hover, QPushButton#btn_sb_help:hover { background-color: #2c302e; color: #ffffff; }
QLabel#lbl_sb_object_count, QLabel#lbl_sb_reviewed, QLabel#lbl_sb_problems,
QLabel#lbl_sb_last_save, QLabel#lbl_sb_sep_1, QLabel#lbl_sb_sep_2, QLabel#lbl_sb_sep_3 {
    color: #e2e2e2; font-family: 'Courier New', 'JetBrains Mono', monospace; font-size: 12px; padding: 0px 6px;
}
QLabel#lbl_sb_sep_1, QLabel#lbl_sb_sep_2, QLabel#lbl_sb_sep_3 { color: #555555; padding: 0px; }
QLabel#lbl_sb_filter_badge {
    color: #e07b39; font-family: 'Courier New', 'JetBrains Mono', monospace;
    font-size: 12px; font-weight: bold; padding: 0px 4px;
}
QPushButton#btn_sb_db_status, QPushButton#btn_sb_log_viewer {
    background: transparent; border: none; color: #c8c8c8;
    font-family: 'Courier New', 'JetBrains Mono', monospace; font-size: 12px; padding: 0px 8px;
}
QPushButton#btn_sb_db_status:hover, QPushButton#btn_sb_log_viewer:hover { color: #ffffff; }
</string>
