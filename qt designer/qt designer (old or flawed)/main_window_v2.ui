  <property name="styleSheet">
   <string notr="true">/* =========================================================
   ARBOR DESIGN SYSTEM: CURATOR WORKSPACE (v2)
   Inspiration: AI_UI_GUIDE, Historical Resolver, Mobile Companion, Startup Dialog
   ========================================================= */

QMainWindow {
    background-color: #fbfaf8;
    color: #2c302e;
    font-family: 'Inter', 'Segoe UI', sans-serif;
}

QSplitter::handle {
    background-color: #c4c7c7;
    width: 1px;
}
QSplitter::handle:hover {
    background-color: #000000;
}

/* ---------------------------------------------------------
   1. TOP NAVIGATION BAR (40px)
   --------------------------------------------------------- */
QFrame#top_bar_frame {
    background-color: #ffffff;
    border-bottom: 1px solid #c4c7c7;
}

QLabel#lbl_brand {
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 13px;
    font-weight: 700;
    color: #000000;
    letter-spacing: 0.05em;
}

QPushButton.NavTopBtn {
    background-color: transparent;
    color: #2c302e;
    border: none;
    border-radius: 2px;
    font-family: 'Inter', 'Segoe UI', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 5px 9px;
}
QPushButton.NavTopBtn:hover {
    background-color: #e9ece5;
    color: #000000;
}
QPushButton.NavTopBtn:pressed {
    background-color: #dadada;
}

QLabel#lbl_save_status {
    font-family: 'JetBrains Mono', monospace;
    color: #3a7d44;
    font-size: 11px;
    font-weight: 700;
}

QPushButton.IconNavBtn {
    background-color: transparent;
    color: #444748;
    border: 1px solid transparent;
    border-radius: 2px;
    font-size: 12px;
    font-weight: bold;
    padding: 4px 8px;
}
QPushButton.IconNavBtn:hover {
    background-color: #e9ece5;
    border-color: #c4c7c7;
    color: #000000;
}

/* ---------------------------------------------------------
   2. IDENTITY STRIP (Full Width)
   --------------------------------------------------------- */
QFrame#identity_strip_frame {
    background-color: #f2f5f1;
    border-bottom: 1px solid #747878;
}

QLabel#lbl_id_badge {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #747878;
    border-radius: 2px;
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 12px;
    font-weight: 700;
    padding: 3px 7px;
}

QLabel#lbl_taxon_name {
    font-family: 'Lora', 'Georgia', serif;
    font-size: 16px;
    font-weight: 700;
    font-style: italic;
    color: #2c302e;
}

QPushButton#btn_status_pill {
    background-color: #ffdad6;
    color: #93000a;
    border: 1px solid #ba1a1a;
    border-radius: 11px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 3px 9px;
}
QPushButton#btn_status_pill:hover {
    background-color: #ffb4ab;
}

QLabel#lbl_location_breadcrumb {
    font-family: 'Inter', sans-serif;
    color: #757d77;
    font-size: 12px;
}

QPushButton.IdentityActionBtn {
    background-color: #ffffff;
    color: #2c302e;
    border: 1px solid #c4c7c7;
    border-radius: 2px;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 9px;
}
QPushButton.IdentityActionBtn:hover {
    background-color: #e9ece5;
    border-color: #747878;
}

/* ---------------------------------------------------------
   3. 40px QUEUE RAIL
   --------------------------------------------------------- */
QFrame#rail_frame {
    background-color: #f2f5f1;
    border-right: 1px solid #c4c7c7;
}

QPushButton#btn_rail_toggle {
    background-color: #ffffff;
    color: #2c302e;
    border: 1px solid #c4c7c7;
    border-radius: 2px;
    font-size: 13px;
    font-weight: bold;
    padding: 6px 0px;
}
QPushButton#btn_rail_toggle:hover {
    background-color: #e9ece5;
    border-color: #747878;
}

QLabel#lbl_rail_progress {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    color: #3a7d44;
}

/* ---------------------------------------------------------
   4. HERO SPECIMEN IMAGE SURFACE
   --------------------------------------------------------- */
QFrame#image_surface_frame {
    background-color: #181c19;
    border: 1px solid #747878;
}

QFrame#floating_image_capsule {
    background-color: rgba(255, 255, 255, 0.94);
    border: 1px solid #747878;
    border-radius: 14px;
}
QFrame#floating_image_capsule QPushButton {
    background-color: transparent;
    color: #2c302e;
    border: none;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 7px;
}
QFrame#floating_image_capsule QPushButton:hover {
    background-color: #e9ece5;
    border-radius: 10px;
    color: #000000;
}

QFrame#filmstrip_frame {
    background-color: rgba(24, 28, 25, 0.92);
    border-top: 1px solid #444748;
}

QPushButton.FilmstripThumb {
    background-color: #2c302e;
    color: #ffffff;
    border: 1px solid #757d77;
    border-radius: 2px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 600;
    padding: 4px 8px;
}
QPushButton.FilmstripThumb:hover {
    border-color: #3a7d44;
    background-color: #3a7d44;
}

/* ---------------------------------------------------------
   5. RIGHT REGISTRATION &amp; CURATOR INSPECTOR
   --------------------------------------------------------- */
QFrame#inspector_column {
    background-color: #fbfaf8;
    border-left: 1px solid #c4c7c7;
}

QFrame#inspector_header_bar {
    background-color: #f2f5f1;
    border-bottom: 1px solid #c4c7c7;
}

QLabel#lbl_inspector_title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #2c302e;
}

/* Tonal Accordion Cards */
QFrame.TonalCard {
    background-color: #ffffff;
    border: 1px solid #c4c7c7;
    border-radius: 2px;
}

QFrame.TonalCardHeader {
    background-color: #f2f5f1;
    border-bottom: 1px solid #c4c7c7;
    padding: 4px 8px;
}

QLabel.MicroLabelCaps {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #757d77;
}

/* Input Fields with 3px Left Accent Bars */
QLineEdit {
    background-color: #f2f5f1;
    color: #2c302e;
    border: 1px solid #c4c7c7;
    border-left: 3px solid #757d77;
    border-radius: 0px;
    padding: 5px 8px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
}
QLineEdit:focus {
    background-color: #ffffff;
    border: 1px solid #000000;
    border-left: 3px solid #000000;
}

/* Problem Highlighted Input (e.g. Genus Problem) */
QLineEdit.ProblemFlaggedInput {
    background-color: #fff9e6;
    border: 1px solid #d9a036;
    border-left: 3px solid #c93a40;
    color: #2c302e;
}

QPushButton.InlineProblemBtn {
    background-color: #ffffff;
    color: #c93a40;
    border: 1px solid #c93a40;
    border-radius: 2px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 6px;
}
QPushButton.InlineProblemBtn:hover {
    background-color: #ffdad6;
}

/* Problem Checklist Box */
QFrame#card_problems_container {
    background-color: #ffffff;
    border: 1px solid #ba1a1a;
    border-radius: 2px;
}

QCheckBox {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: #2c302e;
    spacing: 6px;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #757d77;
    border-radius: 2px;
    background-color: #ffffff;
}
QCheckBox::indicator:checked {
    background-color: #c93a40;
    border-color: #c93a40;
}

/* Sticky Review Action Box */
QFrame#sticky_review_box {
    background-color: #ffffff;
    border-top: 1px solid #747878;
}

QPushButton#btn_mark_reviewed {
    background-color: #3a7d44;
    color: #ffffff;
    border: none;
    border-radius: 2px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 700;
    padding: 9px 16px;
    letter-spacing: 0.03em;
}
QPushButton#btn_mark_reviewed:hover {
    background-color: #2e6436;
}
QPushButton#btn_mark_reviewed:pressed {
    background-color: #1e4524;
}

/* ---------------------------------------------------------
   6. GLOBAL STATUS BAR (22px)
   --------------------------------------------------------- */
QFrame#status_bar_frame {
    background-color: #f2f5f1;
    border-top: 1px solid #c4c7c7;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: #444748;
}

QLabel#lbl_filter_pill {
    background-color: #ffdad6;
    color: #93000a;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 2px;
}
</string>
