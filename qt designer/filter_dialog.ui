  <property name="styleSheet">
   <string notr="true">/* =========================================
   Arbor Filter Dialog Design System Stylesheet
   ========================================= */

QDialog#FilterDialog {
    background-color: #fbfaf8;
    color: #2c302e;
    font-family: 'Segoe UI', 'Inter', -apple-system, sans-serif;
}

QFrame#card_frame {
    background-color: #ffffff;
    border: 1px solid #747878;
    border-radius: 2px;
}

QFrame#header_frame {
    background-color: #fbfaf8;
    border-bottom: 1px solid #c4c7c7;
}

QFrame#footer_frame {
    background-color: #f2f5f1;
    border-top: 1px solid #c4c7c7;
}

QFrame#frame_search {
    background-color: #ffffff;
    border: 1px solid #d95c14;
    border-radius: 2px;
}

QLineEdit#input_filter_search {
    background-color: transparent;
    border: none;
    color: #d95c14;
    font-family: 'Segoe UI', 'Inter', -apple-system, sans-serif;
    font-size: 12px;
}

QLineEdit {
    background-color: #ffffff;
    color: #2c302e;
    border: 1px solid #747878;
    border-radius: 0px;
    padding: 5px 8px;
    font-family: 'Segoe UI', 'Inter', -apple-system, sans-serif;
    font-size: 12px;
}

QLineEdit:focus {
    border: 1px solid #000000;
}

QPushButton {
    background-color: #fbfaf8;
    color: #2c302e;
    border: 1px solid #747878;
    border-radius: 0px;
    padding: 5px 12px;
    font-family: 'Courier New', 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #e9ece5;
}

QPushButton:pressed {
    background-color: #e9ece5;
}

QPushButton#btn_clear_filter {
    background-color: #ffffff;
    border: 1px solid #c93a40;
    color: #c93a40;
}

QPushButton#btn_clear_filter:hover {
    background-color: #e9ece5;
}

QPushButton#btn_apply_filter {
    background-color: #000000;
    border: 1px solid #000000;
    color: #ffffff;
    font-family: 'Segoe UI', 'Inter', -apple-system, sans-serif;
    font-size: 12px;
    font-weight: bold;
    padding: 6px 16px;
}

QPushButton#btn_apply_filter:hover {
    background-color: #2c302e;
}

QTabWidget::pane {
    border: 1px solid #c4c7c7;
    background-color: #ffffff;
    top: -1px;
}

QTabBar::tab {
    background: #e9ece5;
    color: #747878;
    padding: 8px 18px;
    border: 1px solid #c4c7c7;
    border-bottom: none;
    font-family: 'Courier New', 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: bold;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #2c302e;
    border-top: 1px solid #000000;
    border-bottom: 1px solid #ffffff;
}

QTabBar::tab:hover:!selected {
    background: #f2f5f1;
}

QGroupBox {
    font-family: 'Courier New', 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: bold;
    color: #747878;
    border: 1px solid #c4c7c7;
    margin-top: 8px;
    padding-top: 14px;
    background-color: #ffffff;
    border-radius: 2px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    background-color: #ffffff;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    border: none;
    background: #fbfaf8;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #c4c7c7;
    min-height: 20px;
    border-radius: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #747878;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QRadioButton {
    font-family: 'Courier New', 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: bold;
    color: #2c302e;
    spacing: 6px;
}
</string>
