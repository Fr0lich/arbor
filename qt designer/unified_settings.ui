  <property name="styleSheet">
   <string notr="true">QDialog#UnifiedSettingsDialog {
    background-color: #fbfaf8;
    color: #2c302e;
    font-family: 'Segoe UI', 'Inter', -apple-system, sans-serif;
}

QTabWidget::pane {
    border: 1px solid #747878;
    background-color: #ffffff;
    top: -1px;
}

QTabBar::tab {
    background-color: #e9ece5;
    color: #444748;
    border: 1px solid #747878;
    border-bottom: none;
    padding: 7px 18px;
    font-weight: bold;
    font-size: 12px;
}
QTabBar::tab:selected {
    background-color: #ffffff;
    color: #000000;
    border-bottom: 1px solid #ffffff;
}

QLineEdit, QSpinBox, QComboBox {
    background-color: #ffffff;
    color: #2c302e;
    border: 1px solid #747878;
    border-radius: 0px;
    padding: 6px 8px;
    font-size: 12px;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #000000;
}

QCheckBox {
    font-size: 12px;
    color: #2c302e;
}

QPushButton {
    background-color: #fbfaf8;
    color: #2c302e;
    border: 1px solid #747878;
    border-radius: 0px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #e9ece5;
}

QPushButton#btn_save {
    background-color: #000000;
    color: #ffffff;
    border: none;
    padding: 6px 20px;
}
QPushButton#btn_save:hover {
    background-color: #2c302e;
}</string>
