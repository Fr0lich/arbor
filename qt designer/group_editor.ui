}

QListWidget {
    background-color: #ffffff;
    color: #2c302e;
    border: 1px solid #747878;
    border-radius: 0px;
    padding: 4px;
    font-family: 'Courier New', 'JetBrains Mono', monospace;
    font-size: 12px;
}
QListWidget::item {
    padding: 5px 8px;
    border-bottom: 1px solid #f2f5f1;
}
QListWidget::item:hover {
    background-color: #e9ece5;
}
QListWidget::item:selected {
    background-color: #e9ece5;
    color: #000000;
}

QPushButton {
    background-color: #fbfaf8;
    color: #2c302e;
    border: 1px solid #747878;
    border-radius: 0px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #e9ece5;
}

QPushButton#btn_add_group {
    background-color: #000000;
    color: #ffffff;
    border: none;
    padding: 6px 16px;
}
QPushButton#btn_add_group:hover {
    background-color: #2c302e;
}</string>
