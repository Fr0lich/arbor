   <string notr="true">QDialog#AdvancedSearchDialog {
    background-color: #fbfaf8;
    color: #2c302e;
    font-family: 'Segoe UI', 'Inter', -apple-system, sans-serif;
}

QFrame.card {
    background-color: #ffffff;
    border: 1px solid #747878;
    border-radius: 2px;
}

QLabel {
    color: #2c302e;
}

QLabel.section-title {
    font-size: 11px;
    font-weight: bold;
    color: #747878;
    letter-spacing: 0.5px;
}

QLineEdit {
    background-color: #ffffff;
    color: #2c302e;
    border: 1px solid #747878;
    border-radius: 2px;
    padding: 5px 8px;
    font-family: 'Courier New', 'JetBrains Mono', monospace;
    font-size: 12px;
}
QLineEdit:focus {
    border: 1.5px solid #000000;
}

QRadioButton {
    color: #2c302e;
    font-size: 12px;
    spacing: 6px;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
}

QProgressBar {
    border: 1px solid #747878;
    border-radius: 2px;
    text-align: center;
    background-color: #e9ece5;
    height: 14px;
}
QProgressBar::chunk {
    background-color: #3a7d44;
}

QPushButton {
    background-color: #fbfaf8;
    color: #2c302e;
    border: 1px solid #747878;
    border-radius: 2px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #e9ece5;
}

QPushButton#btn_search {
    background-color: #000000;
    color: #ffffff;
    border: 1px solid #000000;
}
QPushButton#btn_search:hover {
    background-color: #2c302e;
}
QPushButton#btn_search:disabled {
    background-color: #747878;
    color: #c4c7c7;
    border-color: #747878;
}
</string>
