  <property name="styleSheet">
   <string notr="true">/* Arbor Qt Design Tokens */
QDialog#StartupDialog {
    background-color: #fbfaf8;
    color: #2c302e;
    font-family: 'Segoe UI', 'Inter', sans-serif;
}

QFrame#card_frame {
    background-color: #ffffff;
    border: 1px solid #747878;
    border-radius: 4px;
}

QFrame#header_frame {
    background-color: #fbfaf8;
    border-bottom: 1px solid #c4c7c7;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QFrame#footer_frame {
    background-color: #f2f5f1;
    border-top: 1px solid #c4c7c7;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

QLabel {
    color: #2c302e;
    font-size: 13px;
}

QLineEdit {
    background-color: #f2f5f1;
    color: #2c302e;
    border: 1px solid #747878;
    border-radius: 2px;
    padding: 6px 8px;
    font-family: 'Courier New', 'JetBrains Mono', monospace;
    font-size: 13px;
}
QLineEdit:focus {
    border: 1px solid #000000;
    background-color: #ffffff;
}

QPushButton {
    background-color: #ffffff;
    color: #2c302e;
    border: 1px solid #747878;
    border-radius: 2px;
    padding: 6px 14px;
    font-weight: 600;
    font-size: 13px;
}
QPushButton:hover {
    background-color: #e9ece5;
}
QPushButton:pressed {
    background-color: #dadada;
}

QPushButton#btn_browse_db, QPushButton#btn_browse_images, QPushButton#btn_browse_books {
    padding: 6px 10px;
    font-weight: bold;
}

QPushButton#btn_launch {
    background-color: #000000;
    color: #ffffff;
    border: 1px solid #000000;
    border-radius: 2px;
    padding: 8px 20px;
    font-weight: bold;
    font-size: 13px;
    letter-spacing: 0.5px;
}
QPushButton#btn_launch:hover {
    background-color: #2c302e;
    border-color: #2c302e;
}
QPushButton#btn_launch:disabled {
    background-color: #dadada;
    color: #747878;
    border-color: #c4c7c7;
}

QComboBox {
    background-color: #f2f5f1;
    color: #2c302e;
    border: 1px solid #747878;
    border-radius: 2px;
    padding: 5px 10px;
    font-size: 13px;
    font-weight: 500;
}
QComboBox:hover {
    background-color: #e9ece5;
}
QComboBox::drop-down {
    border: 0px;
}

QListWidget {
    background-color: #ffffff;
    border: 1px solid #747878;
    border-radius: 2px;
    font-family: 'Courier New', 'JetBrains Mono', monospace;
    font-size: 12px;
}
QListWidget::item {
    padding: 6px 8px;
    border-bottom: 1px solid #f2f5f1;
}
QListWidget::item:hover {
    background-color: #e9ece5;
    color: #000000;
}
QListWidget::item:selected {
    background-color: #e9ece5;
    color: #000000;
}

QRadioButton {
    font-size: 13px;
    color: #2c302e;
    spacing: 6px;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
}

QScrollArea {
    border: none;
    background-color: #ffffff;
}
QScrollArea &gt; QWidget &gt; QWidget {
    background-color: #ffffff;
}
</string>
