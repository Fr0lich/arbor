  <property name="styleSheet">
   <string notr="true">/* =========================================
   Arbor Startup Dialog Theme &amp; Design Tokens
   ========================================= */

QDialog#StartupDialog {
    background-color: #fbfaf8;
    color: #2c302e;
    font-family: 'Segoe UI', 'Inter', -apple-system, sans-serif;
}

/* Single Unified Card Container */
QFrame#card_frame {
    background-color: #ffffff;
    border: 1px solid #747878;
    border-radius: 2px;
}

/* Pinned Header */
QFrame#header_frame {
    background-color: #fbfaf8;
    border-bottom: 1px solid #c4c7c7;
}

/* Pinned Footer */
QFrame#footer_frame {
    background-color: #f2f5f1;
    border-top: 1px solid #c4c7c7;
}

/* Inputs &amp; Textboxes */
QLineEdit {
    background-color: #f2f5f1;
    color: #2c302e;
    border: 1px solid #747878;
    border-radius: 0px;
    padding: 6px 8px;
    font-family: 'Courier New', 'JetBrains Mono', monospace;
    font-size: 13px;
}
QLineEdit:focus {
    background-color: #ffffff;
    border: 1px solid #000000;
}

/* Standard Secondary &amp; Browse Buttons */
QPushButton {
    background-color: #fbfaf8;
    color: #2c302e;
    border: 1px solid #747878;
    border-radius: 0px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #e9ece5;
}
QPushButton:pressed {
    background-color: #dadada;
}

QPushButton#btn_browse_db, 
QPushButton#btn_browse_images, 
QPushButton#btn_browse_books {
    background-color: #fbfaf8;
    color: #444748;
    border: 1px solid #747878;
    padding: 5px 10px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#btn_browse_db:hover, 
QPushButton#btn_browse_images:hover, 
QPushButton#btn_browse_books:hover {
    background-color: #e9ece5;
}

QPushButton#btn_create_db {
    background-color: #f2f5f1;
    color: #000000;
    border: 1px solid #747878;
    font-family: 'Segoe UI', sans-serif;
    font-size: 12px;
    font-weight: bold;
    padding: 5px 14px;
}
QPushButton#btn_create_db:hover {
    background-color: #e9ece5;
}

/* Profile Dropdown */
QComboBox#combo_profile {
    background-color: #f2f5f1;
    color: #2c302e;
    border: 1px solid #747878;
    border-radius: 0px;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 500;
}
QComboBox#combo_profile:hover {
    background-color: #e9ece5;
}
QComboBox#combo_profile::drop-down {
    border: none;
    width: 18px;
}

/* =========================================
   Contiguous Segmented Image Mode Toolbar
   ========================================= */

QFrame#frame_image_modes {
    background-color: #ffffff;
    border: 1px solid #747878;
    border-radius: 0px;
}

QPushButton#btn_mode_online, 
QPushButton#btn_mode_offline {
    background-color: #ffffff;
    color: #444748;
    border: none;
    border-radius: 0px;
    font-family: 'Courier New', 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: bold;
    padding: 7px 10px;
}
QPushButton#btn_mode_online:hover, 
QPushButton#btn_mode_offline:hover {
    background-color: #e9ece5;
    color: #000000;
}

QPushButton#btn_mode_local {
    background-color: #000000;
    color: #ffffff;
    border: none;
    border-radius: 0px;
    font-family: 'Courier New', 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: bold;
    padding: 7px 10px;
}

/* =========================================
   Recent Projects Table
   ========================================= */

QFrame#frame_recent_table {
    background-color: #ffffff;
    border: 1px solid #747878;
    border-radius: 0px;
}

QFrame#frame_recent_header {
    background-color: #f2f5f1;
    border-bottom: 1px solid #747878;
}

QListWidget#list_recent_projects {
    background-color: #ffffff;
    border: none;
    font-family: 'Courier New', 'JetBrains Mono', monospace;
    font-size: 12px;
    color: #2c302e;
}
QListWidget#list_recent_projects::item {
    padding: 6px 8px;
    border-bottom: 1px solid #f2f5f1;
}
QListWidget#list_recent_projects::item:hover {
    background-color: #e9ece5;
    color: #000000;
}
QListWidget#list_recent_projects::item:selected {
    background-color: #e9ece5;
    color: #000000;
}

/* =========================================
   Footer Action Buttons
   ========================================= */

QPushButton#btn_help {
    background-color: #ffffff;
    color: #2c302e;
    border: 1px solid #747878;
    border-radius: 0px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
    font-weight: bold;
    padding: 7px 18px;
}
QPushButton#btn_help:hover {
    background-color: #e9ece5;
}

QPushButton#btn_mobile {
    background-color: #2d6a4f;
    color: #ffffff;
    border: none;
    border-radius: 0px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
    font-weight: bold;
    padding: 7px 16px;
}
QPushButton#btn_mobile:hover {
    background-color: #1b4332;
}
QPushButton#btn_mobile:disabled {
    background-color: #dadada;
    color: #747878;
}

QPushButton#btn_launch {
    background-color: #000000;
    color: #ffffff;
    border: none;
    border-radius: 0px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
    font-weight: bold;
    padding: 7px 24px;
    letter-spacing: 0.5px;
}
QPushButton#btn_launch:hover {
    background-color: #2c302e;
}
QPushButton#btn_launch:pressed {
    background-color: #1a1a1a;
}
QPushButton#btn_launch:disabled {
    background-color: #dadada;
    color: #747878;
}

QScrollArea {
    border: none;
    background-color: #ffffff;
}
QScrollArea &gt; QWidget &gt; QWidget {
    background-color: #ffffff;
}
</string>
