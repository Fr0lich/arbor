  <property name="styleSheet">
   <string notr="true">QDialog#StartupDialog {
    background-color: #fbfaf8;
}
QFrame#card_frame {
    background-color: #ffffff;
    border: 1px solid #747878;
    border-radius: 2px;
}
QFrame#header_frame {
    background-color: #fbfaf8;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
}
QFrame#footer_frame {
    background-color: #f2f5f1;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}
QLabel#lbl_app_tag {
    font-family: &quot;JetBrains Mono&quot;, &quot;Courier New&quot;, monospace;
    font-size: 9pt;
    font-weight: bold;
    color: #000000;
}
QLabel#lbl_title {
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 18pt;
    font-weight: bold;
    color: #2c302e;
}
QFrame#line_header_divider, QFrame#line_footer_divider {
    background-color: #c4c7c7;
    border: none;
    max-height: 1px;
}
QScrollArea#body_scroll_area {
    background-color: #ffffff;
    border: none;
}
QWidget#scrollAreaWidgetContents {
    background-color: #ffffff;
}
QLabel.section-label {
    font-family: &quot;JetBrains Mono&quot;, &quot;Courier New&quot;, monospace;
    font-size: 9pt;
    font-weight: bold;
    color: #444748;
}
QLabel.badge {
    border-radius: 2px;
    padding: 1px 4px;
    font-family: &quot;JetBrains Mono&quot;, &quot;Courier New&quot;, monospace;
    font-size: 8pt;
    font-weight: bold;
    color: #ffffff;
}
QLabel#badge_db_required {
    background-color: #c93a40;
}
QLabel#badge_img_recommended {
    background-color: #3a7d44;
}
QLabel#badge_books_optional {
    background-color: #747878;
}
QLineEdit {
    background-color: #f2f5f1;
    color: #2c302e;
    font-family: &quot;JetBrains Mono&quot;, &quot;Courier New&quot;, monospace;
    font-size: 10pt;
    border: 1px solid #747878;
    border-radius: 2px;
    padding: 4px 6px;
}
QLineEdit:focus {
    background-color: #ffffff;
    border: 1px solid #000000;
}
QPushButton#btn_browse_db, QPushButton#btn_browse_images, QPushButton#btn_browse_books {
    background-color: #fbfaf8;
    color: #444748;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 11pt;
    border: 1px solid #747878;
    border-radius: 2px;
    min-width: 30px;
    max-width: 30px;
}
QPushButton#btn_browse_db:hover, QPushButton#btn_browse_images:hover, QPushButton#btn_browse_books:hover {
    background-color: #e9ece5;
}
QPushButton#btn_create_db {
    background-color: #f2f5f1;
    color: #000000;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9pt;
    font-weight: bold;
    border: 1px solid #747878;
    border-radius: 2px;
    padding: 4px 10px;
}
QPushButton#btn_create_db:hover {
    background-color: #e9ece5;
}
QComboBox#combo_profile {
    background-color: #f2f5f1;
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9pt;
    border: 1px solid #747878;
    border-radius: 2px;
    padding: 3px 8px;
    min-width: 140px;
}
QFrame#frame_image_modes {
    background-color: #ffffff;
    border: 1px solid #747878;
    border-radius: 2px;
}
QPushButton.segment-btn {
    background-color: #ffffff;
    color: #444748;
    font-family: &quot;JetBrains Mono&quot;, &quot;Courier New&quot;, monospace;
    font-size: 9pt;
    font-weight: bold;
    border: none;
    padding: 6px 12px;
}
QPushButton.segment-btn:hover {
    background-color: #e9ece5;
}
QPushButton.segment-btn:checked {
    background-color: #000000;
    color: #ffffff;
}
QFrame.segment-divider {
    background-color: #747878;
    max-width: 1px;
    min-width: 1px;
}
QTableWidget#table_recent_projects {
    background-color: #ffffff;
    border: 1px solid #747878;
    border-radius: 2px;
    gridline-color: #c4c7c7;
    font-family: &quot;JetBrains Mono&quot;, &quot;Courier New&quot;, monospace;
    font-size: 9pt;
}
QTableWidget#table_recent_projects::item {
    padding: 4px 8px;
    color: #2c302e;
}
QTableWidget#table_recent_projects::item:hover {
    background-color: #e9ece5;
}
QTableWidget#table_recent_projects::item:selected {
    background-color: #e9ece5;
    color: #000000;
}
QHeaderView::section {
    background-color: #f2f5f1;
    color: #444748;
    font-family: &quot;JetBrains Mono&quot;, &quot;Courier New&quot;, monospace;
    font-size: 9pt;
    font-weight: bold;
    border: none;
    border-bottom: 1px solid #747878;
    padding: 4px 8px;
}
QPushButton#btn_help {
    background-color: #ffffff;
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 10pt;
    font-weight: bold;
    border: 1px solid #747878;
    border-radius: 2px;
    padding: 6px 16px;
}
QPushButton#btn_help:hover {
    background-color: #e9ece5;
}
QPushButton#btn_mobile {
    background-color: #2d6a4f;
    color: #ffffff;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9pt;
    font-weight: bold;
    border: none;
    border-radius: 2px;
    padding: 6px 14px;
}
QPushButton#btn_mobile:hover {
    background-color: #388463;
}
QPushButton#btn_launch {
    background-color: #000000;
    color: #ffffff;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 10pt;
    font-weight: bold;
    border: none;
    border-radius: 2px;
    padding: 8px 24px;
}
QPushButton#btn_launch:hover {
    background-color: #2c302e;
}
QPushButton#btn_launch:disabled {
    background-color: #dadada;
    color: #757d77;
}
QLabel#lbl_ready_status {
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9pt;
    font-weight: bold;
    color: #3a7d44;
}
QLabel#lbl_status {
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9pt;
    color: #444748;
}</string>
