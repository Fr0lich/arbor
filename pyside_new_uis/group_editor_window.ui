  <property name="styleSheet">
   <string notr="true">QDialog#GroupEditorWindow {
    background-color: #fbfaf8;
    color: #2c302e;
}
QFrame#header_frame {
    background-color: #f2f5f1;
    border-bottom: 1px solid #d1d1d1;
}
QLabel#lbl_header_title {
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 12pt;
    font-weight: bold;
}
QFrame.group-card {
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    border-radius: 3px;
}
QFrame.group-card-header {
    background-color: #f2f5f1;
    border-bottom: 1px solid #d1d1d1;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
}
QLabel.group-card-title {
    color: #000000;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 10pt;
    font-weight: bold;
}
QListWidget {
    background-color: #ffffff;
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9.5pt;
    border: none;
    padding: 4px;
}
QListWidget#fields_listbox {
    font-family: &quot;JetBrains Mono&quot;, monospace;
}
QListWidget::item {
    padding: 4px;
    border-bottom: 1px solid #f2f5f1;
}
QListWidget::item:selected {
    background-color: #2c302e;
    color: #ffffff;
}
QPushButton.tool-btn {
    background-color: #ffffff;
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 8.5pt;
    border: 1px solid #d1d1d1;
    border-radius: 2px;
    padding: 3px 8px;
}
QPushButton.tool-btn:hover {
    background-color: #e9ece5;
}
QPushButton.tool-btn-primary {
    background-color: #ffffff;
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 8.5pt;
    font-weight: bold;
    border: 1px solid #d1d1d1;
    border-radius: 2px;
    padding: 3px 8px;
}
QPushButton.tool-btn-primary:hover {
    background-color: #e9ece5;
}
QPushButton.tool-btn-danger {
    background-color: #ffffff;
    color: #c93a40;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 8.5pt;
    border: 1px solid #d1d1d1;
    border-radius: 2px;
    padding: 3px 8px;
}
QPushButton.tool-btn-danger:hover {
    background-color: #faeaeb;
    border-color: #c93a40;
}
QPushButton#btn_cancel {
    background-color: #ffffff;
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9.5pt;
    border: 1px solid #d1d1d1;
    border-radius: 2px;
    padding: 6px 14px;
}
QPushButton#btn_cancel:hover {
    background-color: #e9ece5;
}
QPushButton#btn_save {
    background-color: #2c302e;
    color: #ffffff;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9.5pt;
    font-weight: bold;
    border: none;
    border-radius: 2px;
    padding: 6px 16px;
}
QPushButton#btn_save:hover {
    background-color: #181c19;
}</string>
