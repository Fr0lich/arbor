  <property name="styleSheet">
   <string notr="true">QDialog#UnifiedSettingsWindow {
    background-color: #fbfaf8;
    color: #2c302e;
}
QFrame#header_frame {
    background-color: #f2f5f1;
    border-bottom: 1px solid #c4c7c7;
}
QLabel#lbl_header_title {
    color: #000000;
    font-family: &quot;Lora&quot;, &quot;Segoe UI&quot;, serif;
    font-size: 14pt;
    font-weight: bold;
}
QLabel#lbl_header_subtitle {
    color: #4c4546;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9pt;
}
QFrame#sidebar_frame {
    background-color: #ebebeb;
    border-right: 1px solid #c4c7c7;
}
QPushButton.nav-tab-btn {
    background-color: transparent;
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 10pt;
    font-weight: bold;
    border: none;
    border-radius: 3px;
    padding: 8px 14px;
    text-align: left;
}
QPushButton.nav-tab-btn:hover {
    background-color: #e0e0e0;
}
QPushButton.nav-tab-btn:checked {
    background-color: #ffffff;
    color: #000000;
    border-left: 3px solid #000000;
}
QScrollArea#scroll_area {
    background-color: #fbfaf8;
    border: none;
}
QWidget#scroll_contents {
    background-color: #fbfaf8;
}
QFrame.setting-card {
    background-color: #ffffff;
    border: 1px solid #c4c7c7;
    border-radius: 4px;
}
QFrame.setting-card-header {
    background-color: #f2f5f1;
    border-bottom: 1px solid #c4c7c7;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}
QLabel.setting-card-title {
    color: #000000;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 10pt;
    font-weight: bold;
}
QLabel.setting-title {
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9.5pt;
    font-weight: bold;
}
QLabel.setting-desc {
    color: #4c4546;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 8.5pt;
}
QFrame#footer_frame {
    background-color: #f2f5f1;
    border-top: 1px solid #c4c7c7;
}
QPushButton#btn_reset_defaults {
    background-color: transparent;
    color: #c93a40;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9pt;
    font-weight: bold;
    border: none;
    padding: 6px 12px;
}
QPushButton#btn_reset_defaults:hover {
    background-color: #faeaeb;
}
QPushButton#btn_cancel {
    background-color: #ffffff;
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9.5pt;
    border: 1px solid #c4c7c7;
    border-radius: 2px;
    padding: 6px 16px;
}
QPushButton#btn_cancel:hover {
    background-color: #e9ece5;
}
QPushButton#btn_save {
    background-color: #000000;
    color: #ffffff;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9.5pt;
    font-weight: bold;
    border: none;
    border-radius: 2px;
    padding: 6px 18px;
}
QPushButton#btn_save:hover {
    background-color: #2c302e;
}</string>
