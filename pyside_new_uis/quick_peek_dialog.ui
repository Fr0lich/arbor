    border-radius: 2px;
}
QPushButton#btn_go_to_object {
    background-color: #3a7d44;
    color: #ffffff;
    font-family: &quot;JetBrains Mono&quot;, &quot;Consolas&quot;, monospace;
    font-size: 10pt;
    font-weight: bold;
    border: none;
    border-radius: 2px;
    padding: 8px 18px;
}
QPushButton#btn_go_to_object:hover {
    background-color: #2d6236;
}
QPushButton#btn_go_to_object:disabled {
    background-color: #dadada;
    color: #8b948d;
}
QLabel[class=&quot;meta-label&quot;] {
    color: #444748;
    font-family: &quot;JetBrains Mono&quot;, &quot;Consolas&quot;, monospace;
    font-size: 9pt;
