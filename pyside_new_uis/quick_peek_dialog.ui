    font-size: 10pt;
    border: none;
    padding: 4px 8px;
}
QListWidget#list_results {
    background-color: #dadada;
    color: #2c302e;
    font-family: &quot;JetBrains Mono&quot;, &quot;Consolas&quot;, monospace;
    font-size: 10pt;
    border: 1px solid #c4c7c7;
    border-radius: 2px;
}
QListWidget#list_results::item {
    padding: 6px 8px;
}
QListWidget#list_results::item:hover {
    background-color: #e9ece5;
}
QListWidget#list_results::item:selected {
    background-color: #3a7d44;
    color: #ffffff;
}
QScrollArea#scroll_data_area {
    background-color: #dadada;
    border: 1px solid #c4c7c7;
    border-radius: 2px;
}
QWidget#data_contents {
    background-color: #dadada;
}
QFrame#frame_image_preview {
    background-color: #f2f5f1;
