    font-size: 10pt;
    font-weight: bold;
}
QPushButton#btn_popout {
    background-color: #e2e2e2;
    color: #2c302e;
    font-family: &quot;JetBrains Mono&quot;, &quot;Consolas&quot;, monospace;
    font-size: 9pt;
    font-weight: bold;
    border: none;
    border-radius: 2px;
    padding: 4px 10px;
}
QPushButton#btn_popout:hover {
    background-color: #dadada;
}
QFrame#search_container {
    background-color: #fbfaf8;
    border: 1px solid #c4c7c7;
    border-radius: 2px;
}
QLineEdit#input_search {
    background-color: #fbfaf8;
    color: #2c302e;
