   <string notr="true">QDialog#ShortcutsHUDDialog {
    background-color: #fbfaf8;
    color: #2c302e;
}
QLabel#lbl_hud_title {
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 13pt;
    font-weight: bold;
}
QLabel#lbl_hud_subtitle {
    color: #757d77;
