    font-size: 9pt;
}
QFrame#search_card {
    background-color: #f2f5f1;
    border: 1px solid #dadada;
    border-radius: 3px;
}
QLineEdit#entry_search {
    background-color: transparent;
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9.5pt;
    border: none;
}
QScrollArea#scroll_area {
    background-color: #fbfaf8;
    border: none;
}
QWidget#scroll_contents {
    background-color: #fbfaf8;
}
QLabel.category-header {
    color: #3a7d44;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 10pt;
    font-weight: bold;
    padding-top: 8px;
    padding-bottom: 2px;
}
QFrame.shortcut-row {
    background-color: #ffffff;
    border: 1px solid #dadada;
    border-radius: 2px;
}
QLabel.key-badge {
    background-color: #f2f5f1;
    color: #2c302e;
    font-family: &quot;JetBrains Mono&quot;, &quot;Consolas&quot;, monospace;
    font-size: 9pt;
    font-weight: bold;
    border: 1px solid #dadada;
    border-radius: 2px;
    padding: 3px 8px;
}
QLabel.shortcut-desc {
    color: #444748;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9pt;
}
QFrame#footer_frame {
    background-color: #fbfaf8;
    border-top: 1px solid #dadada;
}
QLabel#lbl_footer_hint {
    color: #757d77;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 8.5pt;
    font-style: italic;
}
QPushButton#btn_close {
    background-color: #2c302e;
    color: #ffffff;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9.5pt;
    font-weight: bold;
    border: none;
    border-radius: 2px;
    padding: 6px 18px;
}
QPushButton#btn_close:hover {
    background-color: #181c19;
}</string>
