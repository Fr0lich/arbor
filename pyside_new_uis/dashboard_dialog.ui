  <property name="styleSheet">
   <string notr="true">QDialog#DashboardDialog {
    background-color: #fbfaf8;
    color: #2c302e;
}
QFrame#header_frame {
    background-color: #ffffff;
    border-bottom: 1px solid #d1d1d1;
}
QLabel#lbl_title {
    color: #000000;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 12pt;
    font-weight: bold;
}
QScrollArea#scroll_area {
    background-color: #fbfaf8;
    border: none;
}
QWidget#scroll_contents {
    background-color: #fbfaf8;
}
QFrame[class="stat-card"] {
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
}
QFrame[class="stat-card-header"] {
    background-color: #e9ece5;
    border-bottom: 1px solid #d1d1d1;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}
QLabel[class="stat-card-title"] {
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 10pt;
    font-weight: bold;
}
QLabel[class="stat-row-label"] {
    color: #444748;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 10pt;
}
QLabel[class="stat-row-value"] {
    color: #2c302e;
    font-family: &quot;JetBrains Mono&quot;, monospace;
    font-size: 10pt;
    font-weight: bold;
}
QProgressBar#prog_reviewed {
    border: 1px solid #d1d1d1;
    border-radius: 2px;
    background-color: #e9ece5;
    min-height: 12px;
    max-height: 12px;
    text-align: center;
}
QProgressBar#prog_reviewed::chunk {
    background-color: #3a7d44;
    border-radius: 1px;
}
QFrame#footer_frame {
    background-color: #e9ece5;
    border-top: 1px solid #d1d1d1;
}
QPushButton#btn_close {
    background-color: #ffffff;
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 10pt;
    font-weight: bold;
    border: 1px solid #d1d1d1;
    border-radius: 3px;
    padding: 8px 16px;
}
QPushButton#btn_close:hover {
    background-color: #f0f0f0;
}
QPushButton#btn_save_stats {
    background-color: #000000;
    color: #ffffff;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 10pt;
    font-weight: bold;
    border: none;
    border-radius: 3px;
    padding: 8px 16px;
}
QPushButton#btn_save_stats:hover {
    background-color: #2c302e;
}</string>
