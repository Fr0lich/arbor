  <property name="styleSheet">
   <string notr="true">QDialog#AdvancedSettingsWindow {
    background-color: #f9f9f9;
    color: #1a1c1c;
}
QFrame#header_frame {
    background-color: #f3f3f3;
    border-bottom: 1px solid #747878;
}
QLabel#lbl_header_title {
    color: #000000;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 13pt;
    font-weight: bold;
}
QTabWidget::pane {
    background-color: #f9f9f9;
    border: none;
}
QTabBar::tab {
    background-color: #e2e2e2;
    color: #444748;
    font-family: &quot;JetBrains Mono&quot;, monospace;
    font-size: 9.5pt;
    font-weight: bold;
    padding: 8px 16px;
    border: 1px solid #c4c7c7;
    border-bottom: none;
}
QTabBar::tab:selected {
    background-color: #f9f9f9;
    color: #000000;
    border-top: 2px solid #000000;
    border-bottom: 1px solid #f9f9f9;
}
QFrame.setting-card {
    background-color: #ffffff;
    border: 1px solid #c4c7c7;
    border-radius: 3px;
    padding: 10px;
}
QLabel.setting-title {
    color: #1a1c1c;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 10pt;
    font-weight: bold;
}
QLabel.setting-desc {
    color: #444748;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 8.5pt;
}
QFrame#footer_frame {
    background-color: #f3f3f3;
    border-top: 1px solid #747878;
}
QPushButton#btn_reset_defaults {
    background-color: transparent;
    color: #ba1a1a;
    font-family: &quot;JetBrains Mono&quot;, monospace;
    font-size: 9pt;
    font-weight: bold;
    border: none;
    padding: 6px 12px;
}
QPushButton#btn_reset_defaults:hover {
    background-color: #faeaeb;
}
QPushButton#btn_cancel {
    background-color: #ffffff;
    color: #1a1c1c;
    font-family: &quot;JetBrains Mono&quot;, monospace;
    font-size: 9pt;
    font-weight: bold;
    border: 1px solid #747878;
    border-radius: 2px;
    padding: 6px 14px;
}
QPushButton#btn_cancel:hover {
    background-color: #e9ece5;
}
QPushButton#btn_save {
    background-color: #000000;
    color: #ffffff;
    font-family: &quot;JetBrains Mono&quot;, monospace;
    font-size: 9pt;
    font-weight: bold;
    border: none;
    border-radius: 2px;
    padding: 6px 16px;
}
QPushButton#btn_save:hover {
    background-color: #2c302e;
}</string>
