    font-size: 9pt;
    font-weight: bold;
    border: none;
    border-radius: 2px;
    padding: 6px 18px;
}
QPushButton#btn_done:hover {
    background-color: #3d4240;
}
QPushButton#btn_cancel {
    background-color: #ffffff;
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9pt;
    font-weight: bold;
    border: 1px solid #c4c7c7;
    border-radius: 2px;
    padding: 6px 14px;
}
QPushButton#btn_cancel:hover {
    background-color: #e9ece5;
