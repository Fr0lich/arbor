  <property name="styleSheet">
   <string notr="true">QDialog#BulkEditDialog {
    background-color: #fbfaf8;
}
QFrame#header_frame {
    background-color: #fbfaf8;
}
QLabel#lbl_title {
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 13pt;
    font-weight: bold;
}
QPushButton#btn_toggle_layout {
    background-color: #ffffff;
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9pt;
    border: 1px solid #c4c7c7;
    border-radius: 2px;
    padding: 3px 10px;
}
QPushButton#btn_toggle_layout:hover {
    background-color: #e9ece5;
}
QFrame[class="card-outer"] {
    background-color: #ffffff;
    border: 1px solid #c4c7c7;
    border-radius: 2px;
}
QFrame[class="card-header-bar"] {
    background-color: #f2f5f1;
    border-bottom: 1px solid #c4c7c7;
}
QLabel[class="card-title"] {
    font-family: &quot;JetBrains Mono&quot;, &quot;Consolas&quot;, monospace;
    font-size: 9.5pt;
    font-weight: bold;
    color: #000000;
}
QLineEdit, QComboBox {
    background-color: #ffffff;
    color: #2c302e;
    font-family: &quot;JetBrains Mono&quot;, &quot;Consolas&quot;, monospace;
    font-size: 9pt;
    border: 1px solid #c4c7c7;
    border-radius: 2px;
    padding: 4px 6px;
}
QLineEdit:focus, QComboBox:focus {
    border: 1px solid #000000;
}
QPushButton#btn_add_object {
    background-color: #2c302e;
    color: #ffffff;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9pt;
    font-weight: bold;
    border: none;
    border-radius: 2px;
    padding: 4px 12px;
}
QPushButton#btn_add_object:hover {
    background-color: #3d4240;
}
QListWidget#list_targets {
    background-color: #ffffff;
    border: 1px solid #c4c7c7;
    border-radius: 2px;
    font-family: &quot;JetBrains Mono&quot;, monospace;
    font-size: 9.5pt;
    color: #2c302e;
}
QLabel#lbl_hint {
    color: #757d77;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 8pt;
    font-style: italic;
}
QScrollArea#scroll_edit_area {
    background-color: #ffffff;
    border: none;
}
QWidget#edit_contents {
    background-color: #ffffff;
}
QLabel[class="cat-header"] {
    color: #000000;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9.5pt;
    font-weight: bold;
}
QCheckBox[class="field-chk"] {
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9pt;
}
QPushButton#btn_apply_targets {
    background-color: #2c302e;
    color: #ffffff;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9.5pt;
    font-weight: bold;
    border: none;
    border-radius: 2px;
    padding: 8px 18px;
}
QPushButton#btn_apply_targets:hover {
    background-color: #3d4240;
}
QPushButton#btn_destructive {
    background-color: #ffbf00;
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9.5pt;
    font-weight: bold;
    border: 1px solid #d9a036;
    border-radius: 2px;
    padding: 8px 18px;
}
QPushButton#btn_destructive:hover {
    background-color: #e6ac00;
}
QPushButton#btn_destructive:disabled {
    background-color: #e9ece5;
    color: #8b948d;
    border-color: #c4c7c7;
}
QCheckBox#chk_understand {
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 8.5pt;
}</string>
