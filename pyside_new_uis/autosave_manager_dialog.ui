  <property name="styleSheet">
   <string notr="true">QDialog#AutosaveManagerDialog {
    background-color: #fbfaf8;
    color: #2c302e;
}
QLabel#lbl_title {
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 11pt;
    font-weight: bold;
}
QLabel#lbl_subtitle {
    color: #757d77;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9pt;
}
QListWidget#list_archives {
    background-color: #ffffff;
    color: #2c302e;
    font-family: &quot;JetBrains Mono&quot;, &quot;Consolas&quot;, monospace;
    font-size: 9pt;
    border: 1px solid #dadada;
    border-radius: 2px;
    padding: 4px;
}
QListWidget#list_archives::item {
    padding: 6px;
    border-bottom: 1px solid #f2f5f1;
}
QListWidget#list_archives::item:selected {
    background-color: #e9ece5;
    color: #2c302e;
}
QPushButton#btn_restore {
    background-color: #3a7d44;
    color: #ffffff;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9pt;
    font-weight: bold;
    border: none;
    border-radius: 2px;
    padding: 6px 14px;
}
QPushButton#btn_restore:hover {
    background-color: #2e6536;
}
QPushButton#btn_delete, QPushButton#btn_delete_all {
    background-color: #ffffff;
    color: #c93a40;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9pt;
    border: 1px solid #dadada;
    border-radius: 2px;
    padding: 6px 12px;
}
QPushButton#btn_delete:hover, QPushButton#btn_delete_all:hover {
    background-color: #faeaeb;
    border-color: #c93a40;
}
QPushButton#btn_close {
    background-color: #ffffff;
    color: #2c302e;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 9pt;
    border: 1px solid #dadada;
    border-radius: 2px;
    padding: 6px 16px;
}
QPushButton#btn_close:hover {
    background-color: #e9ece5;
}</string>
