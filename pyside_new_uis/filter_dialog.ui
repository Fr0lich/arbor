  <property name="styleSheet">
   <string notr="true">QDialog#FilterDialog {
    background-color: #fbfaf8;
    color: #2c302e;
}
QFrame#header_frame {
    background-color: #f2f5f1;
    border-bottom: 1px solid #747878;
}
QLabel#lbl_title {
    color: #000000;
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;;
    font-size: 14pt;
    font-weight: bold;
}
QFrame#search_frame {
    background-color: #ffffff;
    border: 1px solid #d9480f;
    border-radius: 2px;
}
QLineEdit#entry_search {
    background-color: transparent;
    color: #d9480f;
    font-family: &quot;JetBrains Mono&quot;, monospace;
    font-size: 10pt;
    border: none;
}
QPushButton#btn_load_preset, QPushButton#btn_save_preset {
    background-color: #ffffff;
    color: #2c302e;
    font-family: &quot;JetBrains Mono&quot;, monospace;
    font-size: 9.5pt;
    font-weight: bold;
    border: 1px solid #747878;
    border-radius: 2px;
    padding: 4px 12px;
}
QPushButton#btn_load_preset:hover, QPushButton#btn_save_preset:hover {
    background-color: #e9ece5;
}
QTabWidget::pane {
    background-color: #fbfaf8;
    border: none;
}
QTabBar::tab {
    background-color: #e2e2e2;
    color: #444748;
    font-family: &quot;JetBrains Mono&quot;, monospace;
    font-size: 9.5pt;
    font-weight: bold;
    padding: 8px 18px;
    border: 1px solid #c4c7c7;
    border-bottom: none;
}
QTabBar::tab:selected {
    background-color: #fbfaf8;
    color: #000000;
    border-top: 2px solid #000000;
    border-bottom: 1px solid #fbfaf8;
}
QFrame.filter-group {
    background-color: #ffffff;
    border: 1px solid #c4c7c7;
    border-radius: 2px;
}
QLabel.filter-group-title {
    color: #444748;
    font-family: &quot;JetBrains Mono&quot;, monospace;
    font-size: 9pt;
    font-weight: bold;
    padding-bottom: 4px;
}
QFrame#footer_frame {
    background-color: #f2f5f1;
    border-top: 1px solid #747878;
}
QPushButton#btn_reset_all {
    background-color: transparent;
    color: #c93a40;
    font-family: &quot;JetBrains Mono&quot;, monospace;
    font-size: 9.5pt;
    font-weight: bold;
    border: none;
    padding: 6px 14px;
}
QPushButton#btn_reset_all:hover {
    background-color: #faeaeb;
}
QPushButton#btn_cancel {
    background-color: #ffffff;
    color: #2c302e;
    font-family: &quot;JetBrains Mono&quot;, monospace;
    font-size: 9.5pt;
    font-weight: bold;
    border: 1px solid #747878;
    border-radius: 2px;
    padding: 6px 16px;
}
QPushButton#btn_cancel:hover {
    background-color: #e9ece5;
}
QPushButton#btn_apply {
    background-color: #3e7b3e;
    color: #ffffff;
    font-family: &quot;JetBrains Mono&quot;, monospace;
    font-size: 9.5pt;
    font-weight: bold;
    border: none;
    border-radius: 2px;
    padding: 6px 18px;
}
QPushButton#btn_apply:hover {
    background-color: #2e6536;
}</string>
